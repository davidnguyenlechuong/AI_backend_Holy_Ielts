# ==========================================
# Cấu hình Ứng dụng
# ==========================================
PROJECT_NAME="IELTS AI Platform"
VERSION="1.0.0"

# ==========================================
# Cấu hình Database
# ==========================================
# Chuỗi kết nối PostgreSQL (Sử dụng asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ielts_ai"

# ==========================================
# Cấu hình Bảo mật (Authentication)
# ==========================================
# Secret key để ký JWT (NÊN THAY ĐỔI TRONG MÔI TRƯỜNG PRODUCTION)
SECRET_KEY="supersecretkey_please_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# ==========================================
# Cấu hình Google OAuth (Tùy chọn)
# ==========================================
# Client ID từ Google Cloud Console (dành cho tính năng đăng nhập bằng Google)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==========================================
# Cấu hình AI Provider (openai, gemini, claude)
# ==========================================
AI_PROVIDER="gemini"
AI_SPEAKING_PROVIDER="openai"
AI_WRITING_PROVIDER="openai"

# API Keys
OPENAI_API_KEY="sk-thay-khoa-api-cua-ban-vao-day"
GEMINI_API_KEY="AIzaSy-thay-khoa-api-cua-ban-vao-day"
ANTHROPIC_API_KEY="sk-ant-thay-khoa-api-cua-ban-vao-day"

# ==========================================
# Cấu hình SePay Payment Gateway (Thanh toán tự động - hosted checkout)
# ==========================================
# Lấy từ dashboard my.sepay.vn/pg/payment-methods (bật Test Mode để lấy giá trị sandbox)
SEPAY_API_KEY="thay-api-key-sepay-vao-day"
SEPAY_PG_MERCHANT_ID="thay-merchant-id-sandbox-vao-day"
SEPAY_PG_SECRET_KEY="thay-pg-secret-key-vao-day"
SEPAY_PG_ENV="sandbox"
# X-Secret-Key value SePay's IPN calls must present (merchant auth type = SECRET_KEY); falls back to SEPAY_PG_SECRET_KEY
SEPAY_PG_IPN_SECRET=""
SEPAY_PG_CHECKOUT_URL="https://pay-sandbox.sepay.vn/v1/checkout/init"
FRONTEND_BASE_URL="http://localhost:3000"
SEPAY_PAYMENT_CODE_PREFIX="PREMIUM"
ORDER_EXPIRE_MINUTES="15"

# ==========================================
# Cấu hình PayPal (thẻ + tài khoản PayPal)
# ==========================================
# Lấy từ developer.paypal.com (App sandbox)
PAYPAL_CLIENT_ID="thay-paypal-client-id-vao-day"
PAYPAL_CLIENT_SECRET="thay-paypal-client-secret-vao-day"
PAYPAL_ENV="sandbox"
