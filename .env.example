# ==========================================
# Cấu hình Ứng dụng
# ==========================================
PROJECT_NAME="IELTS AI Platform"
VERSION="1.0.0"

# ==========================================
# Cấu hình Database
# ==========================================
# Chuỗi kết nối PostgreSQL (Sử dụng asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ielts_ai"

# ==========================================
# Cấu hình Bảo mật (Authentication)
# ==========================================
# Secret key để ký JWT (NÊN THAY ĐỔI TRONG MÔI TRƯỜNG PRODUCTION)
SECRET_KEY="supersecretkey_please_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# ==========================================
# Cấu hình Google OAuth (Tùy chọn)
# ==========================================
# Client ID từ Google Cloud Console (dành cho tính năng đăng nhập bằng Google)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==========================================
# Cấu hình AI Provider (openai, gemini, claude)
# ==========================================
AI_PROVIDER="gemini"
AI_SPEAKING_PROVIDER="openai"
AI_WRITING_PROVIDER="openai"

# API Keys
OPENAI_API_KEY="sk-thay-khoa-api-cua-ban-vao-day"
GEMINI_API_KEY="AIzaSy-thay-khoa-api-cua-ban-vao-day"
ANTHROPIC_API_KEY="sk-ant-thay-khoa-api-cua-ban-vao-day"
